# Coded by ueha
# Скопируй в .env (cp .env.example .env) и подставь свои значения.
# Один и тот же AEGIS_IPC_SECRET уходит и в game, и в gate — так и должно быть.
# Сгенерировать секрет: openssl rand -hex 24
AEGIS_IPC_SECRET=REPLACE_WITH_openssl_rand_hex_24
AEGIS_RCON_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
